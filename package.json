{
  "name": "aldermere",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "artifact": "vite build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "balance": "node scripts/balance.mjs",
    "sync": "node scripts/sync.mjs",
    "playtest": "python tests/playtest/play.py",
    "app": "vite build && electron .",
    "package": "vite build && electron-builder --win dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitchk1995/gameopus.git"
  },
  "bugs": {
    "url": "https://github.com/Mitchk1995/gameopus/issues"
  },
  "homepage": "https://github.com/Mitchk1995/gameopus#readme",
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.mitchk1995.aldermere",
    "productName": "Aldermere",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
